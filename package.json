{
  "name": "inhander",
  "version": "1.0.0",
  "description": "In Hand Salary Calculator for Indian Professionals",
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "start": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "astro preview",
    "preview:cf": "ASTRO_TELEMETRY_DISABLED=1 astro build && wrangler dev",
    "deploy": "ASTRO_TELEMETRY_DISABLED=1 astro build && wrangler pages deploy dist --project-name=inhander",
    "deploy:worker": "ASTRO_TELEMETRY_DISABLED=1 astro build && wrangler deploy",
    "deploy:pages": "ASTRO_TELEMETRY_DISABLED=1 astro build && wrangler pages deploy dist --project-name=inhander",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "astro": "^7.2.2",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.2",
    "wrangler": "^4.123.0"
  }
}

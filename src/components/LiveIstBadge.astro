---
// Live IST Time & Location-Aware Weather Badge
---

<div 
  id="ist-badge-container"
  class="inline-flex items-center gap-1.5 sm:gap-2 px-2.5 sm:px-3 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#2a2a2a] text-[12px] sm:text-[13px] font-mono transition-colors select-none cursor-default"
  title="Indian Standard Time (IST) & Bengaluru Live Weather"
>
  <span id="ist-clock" class="font-bold text-[#171717] dark:text-white tracking-tight">--:--</span>
  <span id="ist-weather-icon" class="text-[13px] sm:text-[14px] leading-none" aria-label="Weather">☁️</span>
  <span id="ist-temp" class="font-bold text-[#171717] dark:text-white">24°</span>
  <span class="text-[#888888] dark:text-[#737373] text-[11px] sm:text-[12px] font-medium hidden xs:inline">IST</span>
</div>

<script>
  // Default Coordinates: Bengaluru, India
  const DEFAULT_LOCATION = {
    name: 'Bengaluru',
    lat: 12.9716,
    lon: 77.5946
  };

  const WEATHER_CACHE_KEY = 'inhander_weather_cache_v2';
  const CACHE_DURATION_MS = 10 * 60 * 1000; // 10 minutes cache

  function getWeatherIcon(code: number, isDay: boolean): string {
    if (code === 0) return isDay ? '☀️' : '🌙';
    if (code === 1 || code === 2) return isDay ? '🌤️' : '☁️';
    if (code === 3) return '☁️';
    if (code >= 45 && code <= 48) return '🌫️';
    if ((code >= 51 && code <= 67) || (code >= 80 && code <= 82)) return '🌧️';
    if ((code >= 71 && code <= 77) || (code >= 85 && code <= 86)) return '🌨️';
    if (code >= 95 && code <= 99) return '⛈️';
    return isDay ? '⛅' : '☁️';
  }

  function initIstBadge() {
    const containerEl = document.getElementById('ist-badge-container');
    const clockEl = document.getElementById('ist-clock');
    const weatherIconEl = document.getElementById('ist-weather-icon');
    const tempEl = document.getElementById('ist-temp');

    function updateTime() {
      try {
        const now = new Date();
        const timeStr = now.toLocaleTimeString('en-GB', {
          timeZone: 'Asia/Kolkata',
          hour: '2-digit',
          minute: '2-digit',
          hour12: false
        });
        if (clockEl) {
          clockEl.textContent = timeStr;
        }
      } catch (e) {
        // Fallback to local time if timezone is unsupported
        const now = new Date();
        if (clockEl) {
          clockEl.textContent = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
        }
      }
    }

    function applyWeatherData(temp: number, icon: string, locationLabel: string) {
      if (tempEl) tempEl.textContent = `${temp}°`;
      if (weatherIconEl) weatherIconEl.textContent = icon;
      if (containerEl) {
        containerEl.title = `${locationLabel} Weather (${temp}°C) & Indian Standard Time (IST)`;
      }
    }

    async function fetchWeatherForCoords(lat: number, lon: number, locationName: string) {
      try {
        const url = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,weather_code,is_day&timezone=auto`;
        const res = await fetch(url);
        if (res.ok) {
          const data = await res.json();
          const temp = Math.round(data?.current?.temperature_2m ?? 24);
          const code = data?.current?.weather_code ?? 0;
          const isDay = data?.current?.is_day === 1;
          const icon = getWeatherIcon(code, isDay);

          applyWeatherData(temp, icon, locationName);

          // Cache valid result
          try {
            sessionStorage.setItem(WEATHER_CACHE_KEY, JSON.stringify({
              temp,
              icon,
              locationName,
              lat,
              lon,
              timestamp: Date.now()
            }));
          } catch {
            // Storage quota or privacy mode
          }
        }
      } catch (e) {
        // Retain fallback UI
      }
    }

    function resolveLocationAndWeather() {
      // 1. Check if cached weather exists and is fresh
      try {
        const cached = sessionStorage.getItem(WEATHER_CACHE_KEY);
        if (cached) {
          const parsed = JSON.parse(cached);
          if (Date.now() - parsed.timestamp < CACHE_DURATION_MS) {
            applyWeatherData(parsed.temp, parsed.icon, parsed.locationName);
            return;
          }
        }
      } catch {
        // ignore parse error
      }

      // 2. Request user location; if denied / unavailable, fallback to Bengaluru
      if ('geolocation' in navigator) {
        navigator.geolocation.getCurrentPosition(
          (position) => {
            const userLat = position.coords.latitude;
            const userLon = position.coords.longitude;
            fetchWeatherForCoords(userLat, userLon, 'Local');
          },
          (_error) => {
            // Geolocation denied, timed out, or unavailable -> Fallback to Bengaluru
            fetchWeatherForCoords(DEFAULT_LOCATION.lat, DEFAULT_LOCATION.lon, DEFAULT_LOCATION.name);
          },
          {
            timeout: 6000,
            maximumAge: 300000,
            enableHighAccuracy: false
          }
        );
      } else {
        // Geolocation unsupported -> Fallback to Bengaluru
        fetchWeatherForCoords(DEFAULT_LOCATION.lat, DEFAULT_LOCATION.lon, DEFAULT_LOCATION.name);
      }
    }

    updateTime();
    resolveLocationAndWeather();

    const timer = setInterval(updateTime, 10000);
    return () => clearInterval(timer);
  }

  // Run on initial load and after Astro page transitions
  initIstBadge();
  document.addEventListener('astro:after-swap', initIstBadge);
</script>

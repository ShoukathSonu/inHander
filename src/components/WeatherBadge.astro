---
// Compact Zero-lag, Zero-permission Edge Weather & Live Time Badge
---

<div 
  id="weather-badge"
  class="inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#262626] text-[11px] sm:text-[12px] font-mono font-medium text-[#171717] dark:text-[#ededed] select-none whitespace-nowrap transition-all"
  title="Live Time & Weather"
>
  <span id="header-time" class="tracking-tight">--:--</span>
  <span class="text-[#888888] dark:text-[#737373] text-[10px]" aria-hidden="true">·</span>
  <span id="weather-icon" class="text-[11px] leading-none" aria-hidden="true">📍</span>
  <span id="weather-temp" class="tracking-tight leading-none">24°C</span>
</div>

<script is:inline>
  // 0ms instant paint for live time & cached weather
  (function() {
    function getNowTime() {
      try {
        var now = new Date();
        return now.toLocaleTimeString('en-US', {
          timeZone: 'Asia/Kolkata',
          hour: '2-digit',
          minute: '2-digit',
          hour12: true
        });
      } catch(e) {
        var d = new Date();
        var hours = d.getHours();
        var minutes = d.getMinutes();
        var ampm = hours >= 12 ? 'PM' : 'AM';
        hours = hours % 12;
        hours = hours ? hours : 12;
        var minStr = minutes < 10 ? '0' + minutes : minutes;
        return (hours < 10 ? '0' + hours : hours) + ':' + minStr + ' ' + ampm;
      }
    }

    var timeEl = document.getElementById('header-time');
    if (timeEl) {
      timeEl.textContent = getNowTime();
    }

    try {
      var cached = sessionStorage.getItem('inhander_weather');
      if (cached) {
        var data = JSON.parse(cached);
        if (data && typeof data.temp === 'number' && (Date.now() - (data.timestamp || 0) < 3600000)) {
          var tempEl = document.getElementById('weather-temp');
          if (tempEl) {
            tempEl.textContent = data.temp + '°C';
          }
        }
      }
    } catch(e) {}
  })();
</script>

<script>
  function initLiveTimeAndWeather() {
    const badge = document.getElementById('weather-badge');
    const tempEl = document.getElementById('weather-temp');
    const timeEl = document.getElementById('header-time');

    // 1. Live Clock update every second
    function updateClock() {
      if (!timeEl) return;
      try {
        const now = new Date();
        timeEl.textContent = now.toLocaleTimeString('en-US', {
          timeZone: 'Asia/Kolkata',
          hour: '2-digit',
          minute: '2-digit',
          hour12: true
        });
      } catch {
        const now = new Date();
        let hours = now.getHours();
        const minutes = now.getMinutes();
        const ampm = hours >= 12 ? 'PM' : 'AM';
        hours = hours % 12 || 12;
        const hrStr = hours < 10 ? `0${hours}` : `${hours}`;
        const minStr = minutes < 10 ? `0${minutes}` : `${minutes}`;
        timeEl.textContent = `${hrStr}:${minStr} ${ampm}`;
      }
    }

    updateClock();
    const clockTimer = setInterval(updateClock, 1000);

    // 2. Weather Loader
    const CACHE_KEY = 'inhander_weather';
    const CACHE_TTL_MS = 3600000; // 1 hour

    function renderTemp(temp: number) {
      if (tempEl) {
        tempEl.textContent = `${temp}°C`;
      }
      if (badge) {
        badge.title = `Live Time & Weather: ${temp}°C`;
      }
    }

    // Check sessionStorage cache
    try {
      const cachedStr = sessionStorage.getItem(CACHE_KEY);
      if (cachedStr) {
        const cached = JSON.parse(cachedStr);
        if (
          cached &&
          typeof cached.temp === 'number' &&
          Date.now() - (cached.timestamp || 0) < CACHE_TTL_MS
        ) {
          renderTemp(cached.temp);
          return;
        }
      }
    } catch {
      // Storage unavailable
    }

    // Fetch from Edge API Route (/api/weather)
    fetch('/api/weather')
      .then(async (res) => {
        if (!res.ok) throw new Error('Edge function not available');
        const data = await res.json();
        if (data && typeof data.temp === 'number') {
          renderTemp(data.temp);
          try {
            sessionStorage.setItem(
              CACHE_KEY,
              JSON.stringify({
                temp: data.temp,
                timestamp: Date.now()
              })
            );
          } catch {}
        }
      })
      .catch(async () => {
        // Fallback for local development (`astro dev` on localhost)
        try {
          const fallbackRes = await fetch(
            'https://api.open-meteo.com/v1/forecast?latitude=12.9716&longitude=77.5946&current=temperature_2m'
          );
          if (fallbackRes.ok) {
            const fbData = await fallbackRes.json();
            const temp = Math.round(fbData?.current?.temperature_2m ?? 24);
            renderTemp(temp);
            try {
              sessionStorage.setItem(
                CACHE_KEY,
                JSON.stringify({
                  temp: temp,
                  timestamp: Date.now()
                })
              );
            } catch {}
          }
        } catch {
          // Retain default 24°C
        }
      });
  }

  // Initial mount & Astro page navigation hook
  initLiveTimeAndWeather();
  document.addEventListener('astro:after-swap', initLiveTimeAndWeather);
</script>

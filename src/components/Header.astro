---
import ThemeToggle from './ThemeToggle.astro';
import WeatherBadge from './WeatherBadge.astro';
import { BadgeIndianRupee } from 'lucide-react';

interface Props {
  activeTab?: 'calculator' | 'offers' | 'hike' | 'freelance' | 'slabs';
}

const { activeTab = 'calculator' } = Astro.props;
---

<header 
  id="main-floating-header"
  class="fixed top-3 sm:top-4 left-1/2 -translate-x-1/2 z-50 w-[calc(100%-1.5rem)] sm:w-[calc(100%-3rem)] max-w-[1240px] transition-all duration-400 ease-[cubic-bezier(0.16,1,0.3,1)] transform will-change-transform"
>
  <div class="w-full bg-white/85 dark:bg-[#121212]/85 backdrop-blur-xl border border-[#ebebeb]/90 dark:border-[#262626]/90 rounded-full shadow-[0_8px_30px_rgb(0,0,0,0.06)] dark:shadow-[0_8px_30px_rgb(0,0,0,0.35)] px-3.5 sm:px-5 h-13 sm:h-14 flex items-center justify-between transition-colors">
    
    <!-- Left: Brand Logo with Rolling Favicon & inHander.com Reveal -->
    <div class="flex items-center gap-2 shrink-0">
      <a 
        href="/" 
        id="header-brand-logo"
        class="brand-logo-roll-container group relative inline-flex items-center select-none" 
        aria-label="inHander Homepage"
      >
        <!-- Rolling Favicon Icon Badge -->
        <div class="brand-rolling-icon relative w-8 h-8 rounded-full bg-[#171717] dark:bg-white flex items-center justify-center text-white dark:text-[#171717] shadow-xs z-20 shrink-0">
          <BadgeIndianRupee className="w-4 h-4" />
        </div>

        <!-- Revealed Brand Text Container (inHander.com) -->
        <div class="brand-revealed-text-wrap relative z-10 flex items-baseline pl-2.5">
          <span class="brand-logo-name text-[16px] font-bold text-[#171717] dark:text-white tracking-tight">
            in<span class="font-extrabold text-[#171717] dark:text-white">Hander</span>
          </span>
          <span class="brand-logo-tld text-[11.5px] font-mono font-medium text-[#888888] dark:text-[#737373] ml-0.5 opacity-80">.com</span>
        </div>
      </a>
    </div>

    <!-- Center: Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-1">
      <a 
        href="/" 
        class={`px-3.5 py-1.5 rounded-full text-[13px] font-medium transition-colors ${activeTab === 'calculator' ? 'bg-[#f5f5f5] dark:bg-[#1e1e1e] text-[#171717] dark:text-white font-semibold' : 'text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white hover:bg-[#fafafa] dark:hover:bg-[#181818]'}`}
      >
        Calculator
      </a>
      <a 
        href="/compare-offers" 
        class={`px-3.5 py-1.5 rounded-full text-[13px] font-medium transition-colors ${activeTab === 'offers' ? 'bg-[#f5f5f5] dark:bg-[#1e1e1e] text-[#171717] dark:text-white font-semibold' : 'text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white hover:bg-[#fafafa] dark:hover:bg-[#181818]'}`}
      >
        Compare Offers
      </a>
      <a 
        href="/hike-calculator" 
        class={`px-3.5 py-1.5 rounded-full text-[13px] font-medium transition-colors ${activeTab === 'hike' ? 'bg-[#f5f5f5] dark:bg-[#1e1e1e] text-[#171717] dark:text-white font-semibold' : 'text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white hover:bg-[#fafafa] dark:hover:bg-[#181818]'}`}
      >
        Hike Simulator
      </a>
      <a 
        href="/44ada-freelance" 
        class={`px-3.5 py-1.5 rounded-full text-[13px] font-medium transition-colors ${activeTab === 'freelance' ? 'bg-[#f5f5f5] dark:bg-[#1e1e1e] text-[#171717] dark:text-white font-semibold' : 'text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white hover:bg-[#fafafa] dark:hover:bg-[#181818]'}`}
      >
        44ADA Freelance
      </a>
      <a 
        href="/guide" 
        class={`px-3.5 py-1.5 rounded-full text-[13px] font-medium transition-colors ${activeTab === 'guide' ? 'bg-[#f5f5f5] dark:bg-[#1e1e1e] text-[#171717] dark:text-white font-semibold' : 'text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white hover:bg-[#fafafa] dark:hover:bg-[#181818]'}`}
      >
        Payroll Guide
      </a>
      <a 
        href="/tax-slabs" 
        class={`px-3.5 py-1.5 rounded-full text-[13px] font-medium transition-colors ${activeTab === 'slabs' ? 'bg-[#f5f5f5] dark:bg-[#1e1e1e] text-[#171717] dark:text-white font-semibold' : 'text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white hover:bg-[#fafafa] dark:hover:bg-[#181818]'}`}
      >
        Tax Slabs
      </a>
    </nav>

    <!-- Right: Weather Badge & Theme Toggle -->
    <div class="flex items-center gap-2 sm:gap-2.5">
      <!-- Zero-Permission Edge-Powered Weather Badge -->
      <WeatherBadge />

      <!-- Dark/Light Mode Theme Toggle -->
      <ThemeToggle />

      <!-- Mobile menu trigger -->
      <button 
        id="mobile-menu-btn"
        aria-label="Toggle mobile menu"
        class="lg:hidden p-2 rounded-full text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white hover:bg-[#f5f5f5] dark:hover:bg-[#181818] transition-colors"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Dropdown -->
  <div id="mobile-menu" class="hidden lg:hidden mt-2 rounded-2xl border border-[#ebebeb] dark:border-[#262626] bg-white/95 dark:bg-[#121212]/95 backdrop-blur-xl px-4 py-3 space-y-1 shadow-modal">
    <a href="/" class="block px-3 py-2 rounded-lg text-sm font-medium text-[#171717] dark:text-white hover:bg-[#f5f5f5] dark:hover:bg-[#1e1e1e]">Take-Home Calculator</a>
    <a href="/guide" class="block px-3 py-2 rounded-lg text-sm font-medium text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white hover:bg-[#f5f5f5] dark:hover:bg-[#1e1e1e]">Payroll &amp; Tax Guide</a>
    <a href="/compare-offers" class="block px-3 py-2 rounded-lg text-sm font-medium text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white hover:bg-[#f5f5f5] dark:hover:bg-[#1e1e1e]">Compare Job Offers</a>
    <a href="/hike-calculator" class="block px-3 py-2 rounded-lg text-sm font-medium text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white hover:bg-[#f5f5f5] dark:hover:bg-[#1e1e1e]">Salary Hike Simulator</a>
    <a href="/44ada-freelance" class="block px-3 py-2 rounded-lg text-sm font-medium text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white hover:bg-[#f5f5f5] dark:hover:bg-[#1e1e1e]">44ADA Freelance &amp; Consultant</a>
    <a href="/tax-slabs" class="block px-3 py-2 rounded-lg text-sm font-medium text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white hover:bg-[#f5f5f5] dark:hover:bg-[#1e1e1e]">Tax Slabs (FY 2025-26 &amp; 26-27)</a>
    <a href="/privacy" class="block px-3 py-2 rounded-lg text-sm font-medium text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white hover:bg-[#f5f5f5] dark:hover:bg-[#1e1e1e]">Privacy (100% Client-Side)</a>
  </div>
</header>

<script>
  function setupHeaderScroll() {
    let lastScrollY = window.scrollY;
    let ticking = false;
    const header = document.getElementById('main-floating-header');
    const menu = document.getElementById('mobile-menu');
    const btn = document.getElementById('mobile-menu-btn');

    if (btn && menu) {
      btn.onclick = (e) => {
        e.stopPropagation();
        menu.classList.toggle('hidden');
      };

      document.addEventListener('click', (e) => {
        if (!menu.contains(e.target as Node) && !btn.contains(e.target as Node)) {
          menu.classList.add('hidden');
        }
      });
    }

    function updateNavbar() {
      if (!header) return;
      const currentScrollY = window.scrollY;
      const scrollDelta = currentScrollY - lastScrollY;

      if (currentScrollY <= 40) {
        // Near top of page: always display
        header.classList.remove('-translate-y-28', 'opacity-0', 'scale-[0.98]', 'pointer-events-none');
        header.classList.add('translate-y-0', 'opacity-100', 'scale-100');
      } else if (scrollDelta > 8 && currentScrollY > 80) {
        // Scrolling DOWN: smoothly slide up and hide
        header.classList.add('-translate-y-28', 'opacity-0', 'scale-[0.98]', 'pointer-events-none');
        header.classList.remove('translate-y-0', 'opacity-100', 'scale-100');
        if (menu && !menu.classList.contains('hidden')) {
          menu.classList.add('hidden');
        }
      } else if (scrollDelta < -8) {
        // Scrolling UP: smoothly slide down and reveal
        header.classList.remove('-translate-y-28', 'opacity-0', 'scale-[0.98]', 'pointer-events-none');
        header.classList.add('translate-y-0', 'opacity-100', 'scale-100');
      }

      lastScrollY = Math.max(0, currentScrollY);
      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(updateNavbar);
        ticking = true;
      }
    }

    window.removeEventListener('scroll', onScroll);
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  function setupLogoReveal() {
    const logo = document.getElementById('header-brand-logo');
    if (!logo) return;

    // Trigger entrance animation once upon initial page mount
    const timer = setTimeout(() => {
      logo.classList.add('is-revealing');
    }, 150);

    // Cleanly remove is-revealing class when complete (3.6s total duration + buffer)
    const cleanupTimer = setTimeout(() => {
      logo.classList.remove('is-revealing');
    }, 3800);
  }

  setupHeaderScroll();
  setupLogoReveal();
  document.addEventListener('astro:after-swap', () => {
    setupHeaderScroll();
    setupLogoReveal();
  });
</script>

<style>
  /* =========================================================
     inHander.com Favicon Roll + Pure Tiranga (Saffron-White-Green)
     ========================================================= */

  :root {
    --brand-text-base: #171717;
  }
  :global(.dark) {
    --brand-text-base: #ededed;
  }

  .brand-logo-roll-container {
    position: relative;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  /* 1. Rolling Favicon Icon Badge */
  .brand-rolling-icon {
    transform-origin: center center;
    will-change: transform, filter;
    transform: translateX(0px) rotate(0deg);
  }

  /* 2. Revealed Brand Text Container (inHander.com) */
  .brand-revealed-text-wrap {
    display: inline-flex;
    align-items: baseline;
    will-change: clip-path, opacity, background-position, filter;
    clip-path: inset(0 0% 0 0);
    opacity: 1;
    color: var(--brand-text-base);
    background: linear-gradient(
      105deg,
      var(--brand-text-base) 0%,
      var(--brand-text-base) 28%,
      #FF671F 37%,
      #FF9933 42%,
      #FFFFFF 48%,
      #FFFFFF 52%,
      #138808 58%,
      #046A38 63%,
      var(--brand-text-base) 72%,
      var(--brand-text-base) 100%
    );
    background-size: 400% 100%;
    background-position: 0% 0;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* ---------------------------------------------------------
     Keyframe Choreography (3.6s Total Duration):
     1. Favicon rolls right from 0px to 118px (+0.5s slower: 0s -> 0.72s)
     2. Text unmasks directly in its wake (0s -> 0.72s)
     3. Favicon returns to dock at 0px (0.86s -> 1.5s)
     4. Pure Indian Flag (Saffron-White-Green) illuminates for ~1.8s (1.5s -> 3.3s)
     5. Smoothly transitions back to 100% clean base theme color (no lingering color)
     --------------------------------------------------------- */

  @keyframes favicon-roll-sweep {
    0% {
      transform: translateX(0px) rotate(0deg);
    }
    20% {
      transform: translateX(118px) rotate(430deg);
    }
    24% {
      transform: translateX(118px) rotate(430deg);
    }
    40% {
      transform: translateX(-1.5px) rotate(-6deg);
    }
    44% {
      transform: translateX(0px) rotate(0deg);
    }
    100% {
      transform: translateX(0px) rotate(0deg);
    }
  }

  @keyframes text-reveal-wipe {
    0% {
      clip-path: inset(0 100% 0 0);
      opacity: 0.1;
    }
    20% {
      clip-path: inset(0 0% 0 0);
      opacity: 1;
    }
    100% {
      clip-path: inset(0 0% 0 0);
      opacity: 1;
    }
  }

  @keyframes text-tiranga-shimmer {
    /* During rolling (0s -> 1.5s): 100% clean base color */
    0%, 42% {
      background-position: 0% 0;
      filter: drop-shadow(0 0 0 transparent);
    }
    /* Indian flag colors bloom (1.5s -> 3.3s: ~1.8s duration) */
    52% {
      background-position: 43% 0;
      filter: drop-shadow(-3px 0 6px rgba(255, 103, 31, 0.45)) drop-shadow(3px 0 6px rgba(19, 136, 8, 0.45));
    }
    68% {
      background-position: 50% 0;
      filter: drop-shadow(-4px 0 8px rgba(255, 103, 31, 0.55)) drop-shadow(4px 0 8px rgba(19, 136, 8, 0.55));
    }
    82% {
      background-position: 57% 0;
      filter: drop-shadow(-3px 0 6px rgba(255, 103, 31, 0.4)) drop-shadow(3px 0 6px rgba(19, 136, 8, 0.4));
    }
    94% {
      background-position: 98% 0;
      filter: drop-shadow(0 0 0 transparent);
    }
    /* 100% Rest state: completely cleared to base monochrome */
    100% {
      background-position: 100% 0;
      filter: drop-shadow(0 0 0 transparent);
    }
  }

  /* Favicon icon subtle Tiranga glow when docked */
  @keyframes icon-tiranga-aura {
    0%, 42% {
      filter: drop-shadow(0 0 0 transparent);
    }
    60% {
      filter: drop-shadow(0 0 8px rgba(255, 103, 31, 0.5)) drop-shadow(0 0 10px rgba(19, 136, 8, 0.4));
    }
    80% {
      filter: drop-shadow(0 0 6px rgba(255, 103, 31, 0.35)) drop-shadow(0 0 8px rgba(19, 136, 8, 0.3));
    }
    100% {
      filter: drop-shadow(0 0 0 transparent);
    }
  }

  /* Trigger on initial page load (.is-revealing) OR on hover (:hover) */
  .brand-logo-roll-container.is-revealing .brand-rolling-icon,
  .brand-logo-roll-container:hover .brand-rolling-icon {
    animation: 
      favicon-roll-sweep 3.6s cubic-bezier(0.25, 1, 0.35, 1) forwards,
      icon-tiranga-aura 3.6s ease forwards;
  }

  .brand-logo-roll-container.is-revealing .brand-revealed-text-wrap,
  .brand-logo-roll-container:hover .brand-revealed-text-wrap {
    animation: 
      text-reveal-wipe 3.6s cubic-bezier(0.25, 1, 0.35, 1) forwards,
      text-tiranga-shimmer 3.6s ease-in-out forwards;
  }

  /* Accessibility: Prefers Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .brand-rolling-icon,
    .brand-revealed-text-wrap {
      animation: none !important;
      transform: none !important;
      clip-path: none !important;
      opacity: 1 !important;
      filter: none !important;
    }
  }
</style>

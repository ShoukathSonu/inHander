<script>
  function setupGuideToggle() {
    const toggleBtn = document.getElementById('guide-toggle-all-btn');
    const toggleText = document.getElementById('guide-toggle-text');
    const toggleIcon = document.getElementById('guide-toggle-icon');
    const chapters = document.querySelectorAll<HTMLDetailsElement>('.guide-chapter');

    if (!toggleBtn || !chapters.length) return;

    function updateButtonState() {
      const allOpen = Array.from(chapters).every(c => c.open);
      if (toggleText) {
        toggleText.textContent = allOpen ? 'Collapse All Chapters' : 'Expand All Chapters';
      }
      if (toggleIcon) {
        toggleIcon.style.transform = allOpen ? 'rotate(180deg)' : 'rotate(0deg)';
      }
    }

    toggleBtn.addEventListener('click', () => {
      const allOpen = Array.from(chapters).every(c => c.open);
      chapters.forEach(c => {
        c.open = !allOpen;
      });
      updateButtonState();
    });

    chapters.forEach(c => {
      c.addEventListener('toggle', updateButtonState);
    });

    function checkHash() {
      if (window.location.hash) {
        const targetElement = document.querySelector<HTMLDetailsElement>(window.location.hash);
        if (targetElement && targetElement.tagName === 'DETAILS') {
          targetElement.open = true;
          updateButtonState();
        }
      }
    }

    // Check URL hash on load and when hash changes
    checkHash();
    window.addEventListener('hashchange', checkHash);
  }

  // Run on page load and view transitions
  setupGuideToggle();
  document.addEventListener('astro:page-load', setupGuideToggle);
</script>

---
import { formatINR } from '../lib/formatters';

const POPULAR_PACKAGES = [
  { lpa: '3-lpa', label: '₹3 LPA', gross: 300000, monthlyApprox: 23200, tax: 0, tag: 'Fresher' },
  { lpa: '4-5-lpa', label: '₹4.5 LPA', gross: 450000, monthlyApprox: 34800, tax: 0, tag: 'Zero Tax' },
  { lpa: '6-lpa', label: '₹6 LPA', gross: 600000, monthlyApprox: 46200, tax: 0, tag: 'Zero Tax' },
  { lpa: '10-lpa', label: '₹10 LPA', gross: 1000000, monthlyApprox: 72800, tax: 46800, tag: 'Popular' },
  { lpa: '12-lpa', label: '₹12 LPA', gross: 1200000, monthlyApprox: 86400, tax: 78000, tag: 'Mid-Level' },
  { lpa: '15-lpa', label: '₹15 LPA', gross: 1500000, monthlyApprox: 106000, tax: 130000, tag: 'Senior SDE' },
  { lpa: '20-lpa', label: '₹20 LPA', gross: 2000000, monthlyApprox: 138000, tax: 260000, tag: 'Lead / PM' },
  { lpa: '25-lpa', label: '₹25 LPA', gross: 2500000, monthlyApprox: 168000, tax: 416000, tag: 'Tech Lead' },
  { lpa: '30-lpa', label: '₹30 LPA', gross: 3000000, monthlyApprox: 198000, tax: 572000, tag: 'Staff Eng' },
  { lpa: '50-lpa', label: '₹50 LPA', gross: 5000000, monthlyApprox: 312000, tax: 1248000, tag: 'Principal / EM' },
  { lpa: '1-cr', label: '₹1 Crore', gross: 10000000, monthlyApprox: 585000, tax: 3120000, tag: 'Executive / VP' },
];
---

<div class="w-full max-w-6xl mx-auto space-y-6 pt-12">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <div>
      <span class="text-[12px] font-mono uppercase tracking-wider text-[#888888] dark:text-[#737373] font-semibold">
        Quick Salary Benchmarks
      </span>
      <h2 class="text-2xl sm:text-3xl font-bold text-[#171717] dark:text-white tracking-tight">
        Explore in-hand salary for standard CTC packages.
      </h2>
    </div>
    <span class="text-[13px] font-mono text-[#888888] dark:text-[#737373]">
      FY 2025-26 & 26-27 (New Tax Regime)
    </span>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
    {POPULAR_PACKAGES.map((pkg) => (
      <a
        href={`/salary/${pkg.lpa}`}
        class="group p-5 rounded-2xl bg-white dark:bg-[#121212] border border-[#ebebeb] dark:border-[#262626] shadow-stacked-sm hover:shadow-stacked hover:border-[#171717] dark:hover:border-white transition-all space-y-3 flex flex-col justify-between"
      >
        <div class="space-y-1">
          <div class="flex items-center justify-between">
            <span class="text-xl font-bold font-mono text-[#171717] dark:text-white group-hover:text-[#0070f3] dark:group-hover:text-[#50e3c2] transition-colors">
              {pkg.label}
            </span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-[#f5f5f5] dark:bg-[#1e1e1e] text-[#4d4d4d] dark:text-[#a1a1a1] border border-[#ebebeb] dark:border-[#262626]">
              {pkg.tag}
            </span>
          </div>
          <span class="text-[11px] font-mono text-[#888888] dark:text-[#737373] block">
            Annual CTC
          </span>
        </div>

        <div className="pt-2 border-t border-[#ebebeb] dark:border-[#262626] space-y-1">
          <div class="flex justify-between items-baseline">
            <span class="text-[11px] text-[#888888] dark:text-[#737373]">In-Hand / Mo:</span>
            <span class="text-[15px] font-bold font-mono text-[#10b981]">
              ~{formatINR(pkg.monthlyApprox)}
            </span>
          </div>
          <div class="flex justify-between items-baseline text-[11px] text-[#888888] dark:text-[#737373]">
            <span>Est. Tax:</span>
            <span class="font-mono">{pkg.tax === 0 ? '₹0 (Rebate)' : `~${formatINR(pkg.tax)}`}</span>
          </div>
        </div>
      </a>
    ))}
  </div>
</div>

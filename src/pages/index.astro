---
import Layout from '../layouts/Layout.astro';
import { SalaryCalculator } from '../components/SalaryCalculator';
import FaqSection from '../components/FaqSection.astro';
import { Check } from 'lucide-react';
---

<Layout 
  title="In Hand Salary Calculator India (FY 2025-26 & 26-27) | inHander.com"
  description="Calculate exact in hand salary from CTC in India under New and Old Tax Regimes (FY 2025-26 & 26-27). Standard deduction ₹75,000, 87A rebate, HRA exemption, and payslip PDF export."
  keywords="In Hand Salary, in hand salary calculator, in hand salary calculator india, calculate in hand salary, india in hand salary calculator, lpa in hand salary, tax calculator, income tax calculator, paycheck tax calculator, 4 lpa in hand salary, 4.5 lpa in hand salary, 10 lpa in hand salary, 12 lpa in hand salary, 18 lpa in hand salary, in hand salary calculator after tax"
  activeTab="calculator"
>
  <!-- Hero Band -->
  <section class="text-center space-y-3 sm:space-y-4 pt-2 sm:pt-4 pb-5 sm:pb-7 max-w-5xl mx-auto px-2 sm:px-4">
    <!-- Section Eyebrow -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-black/5 dark:bg-white/5 text-xs text-[#666666] dark:text-[#999999] font-normal">
      <span class="w-2 h-2 rounded-full bg-[#10b981]"></span>
      <span>Budget 2024 / FY 2025-26 &amp; 26-27 Slabs Active</span>
    </div>

    <!-- Hero Headline (Solid monochrome without gradient) -->
    <h1 class="text-3xl min-[420px]:text-4xl sm:text-5xl lg:text-6xl font-bold text-[#171717] dark:text-white tracking-tight leading-tight">
      Calculate your in hand salary.
    </h1>

    <!-- Punchy Human-Readable Subhead -->
    <p class="text-sm sm:text-base md:text-lg text-[#666666] dark:text-[#a1a1a1] max-w-2xl mx-auto leading-relaxed font-normal">
      Convert your CTC to exact monthly take-home pay. Instantly compare tax regimes, optimize deductions, and generate a secure payslip.
    </p>

    <!-- Clean Secondary Trust Signals (Zero Pill Background Clutter) -->
    <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 pt-1 text-[11px] sm:text-xs text-[#737373] dark:text-[#888888] font-normal">
      <span class="inline-flex items-center gap-1.5">
        <Check className="w-3.5 h-3.5 text-[#10b981] shrink-0" />
        <span>₹7.75L tax-free in New Regime</span>
      </span>
      <span class="inline-flex items-center gap-1.5">
        <Check className="w-3.5 h-3.5 text-[#10b981] shrink-0" />
        <span>Dual Tax Regime Comparison</span>
      </span>
      <span class="inline-flex items-center gap-1.5">
        <Check className="w-3.5 h-3.5 text-[#10b981] shrink-0" />
        <span>1-Click Payslip PDF</span>
      </span>
      <span class="inline-flex items-center gap-1.5">
        <Check className="w-3.5 h-3.5 text-[#10b981] shrink-0" />
        <span>100% Client-Side Private</span>
      </span>
    </div>
  </section>

  <!-- Primary Interactive Salary Calculator -->
  <section class="w-full">
    <SalaryCalculator client:load />
  </section>

  <!-- Value Props / Feature Highlights (Compact Bullet Points for Clean Negative Space) -->
  <section class="max-w-4xl mx-auto mt-12 sm:mt-16 text-center space-y-3">
    <h2 class="text-base sm:text-lg font-semibold text-[#171717] dark:text-white tracking-tight">
      Why Indian professionals rely on inHander
    </h2>
    <ul class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-8 text-xs sm:text-sm text-[#666666] dark:text-[#999999] font-normal list-none p-0">
      <li class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-[#0070f3] shrink-0"></span>
        <span>Dual regime tax comparison (Budget 2024)</span>
      </li>
      <li class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-[#10b981] shrink-0"></span>
        <span>Salary slip generation &amp; PDF export</span>
      </li>
      <li class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-[#7928ca] shrink-0"></span>
        <span>100% Private in-browser computation</span>
      </li>
    </ul>
  </section>

  <!-- Popular Salary Packages Directory -->
  <section class="max-w-5xl mx-auto mt-16 sm:mt-24 p-8 sm:p-12 rounded-3xl bg-white dark:bg-[#121212] shadow-sm space-y-8">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
      <div>
        <h2 class="text-lg sm:text-xl font-semibold text-[#171717] dark:text-white">
          Popular in hand salary packages in India
        </h2>
        <span class="text-xs text-[#888888] dark:text-[#777777] font-normal block mt-0.5">
          Pre-computed take-home &amp; tax under Budget 2024
        </span>
      </div>
    </div>

    <!-- Quick Pill Grid (Border-free 2-4% grey blocks) -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3 text-xs">
      <a href="/salary/3-lpa" class="p-3.5 rounded-2xl bg-[#fafafa] dark:bg-[#181818] hover:bg-[#f0f0f0] dark:hover:bg-[#202020] transition-colors text-center group">
        <strong class="text-[#171717] dark:text-white block font-medium group-hover:text-[#0070f3]">₹3 LPA</strong>
        <span class="text-[#10b981] block mt-0.5">₹23.1k/mo</span>
      </a>
      <a href="/salary/3-25-lpa" class="p-3.5 rounded-2xl bg-[#fafafa] dark:bg-[#181818] hover:bg-[#f0f0f0] dark:hover:bg-[#202020] transition-colors text-center group">
        <strong class="text-[#171717] dark:text-white block font-medium group-hover:text-[#0070f3]">₹3.25 LPA</strong>
        <span class="text-[#10b981] block mt-0.5">₹25.0k/mo</span>
      </a>
      <a href="/salary/3-36-lpa" class="p-3.5 rounded-2xl bg-[#fafafa] dark:bg-[#181818] hover:bg-[#f0f0f0] dark:hover:bg-[#202020] transition-colors text-center group">
        <strong class="text-[#171717] dark:text-white block font-medium group-hover:text-[#0070f3]">₹3.36 LPA</strong>
        <span class="text-[#10b981] block mt-0.5">₹25.9k/mo</span>
      </a>
      <a href="/salary/3-5-lpa" class="p-3.5 rounded-2xl bg-[#fafafa] dark:bg-[#181818] hover:bg-[#f0f0f0] dark:hover:bg-[#202020] transition-colors text-center group">
        <strong class="text-[#171717] dark:text-white block font-medium group-hover:text-[#0070f3]">₹3.5 LPA</strong>
        <span class="text-[#10b981] block mt-0.5">₹27.0k/mo</span>
      </a>
      <a href="/salary/4-lpa" class="p-3.5 rounded-2xl bg-[#fafafa] dark:bg-[#181818] hover:bg-[#f0f0f0] dark:hover:bg-[#202020] transition-colors text-center group">

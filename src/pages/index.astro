        <span class="text-[#10b981] block mt-0.5">₹72.8k/mo</span>
      </a>
      <a href="/salary/12-lpa" class="p-3.5 rounded-2xl bg-[#fafafa] dark:bg-[#181818] hover:bg-[#f0f0f0] dark:hover:bg-[#202020] transition-colors text-center group">
        <strong class="text-[#171717] dark:text-white block font-medium group-hover:text-[#0070f3]">₹12 LPA</strong>
        <span class="text-[#10b981] block mt-0.5">₹86.4k/mo</span>
      </a>
      <a href="/salary/15-lpa" class="p-3.5 rounded-2xl bg-[#fafafa] dark:bg-[#181818] hover:bg-[#f0f0f0] dark:hover:bg-[#202020] transition-colors text-center group">
        <strong class="text-[#171717] dark:text-white block font-medium group-hover:text-[#0070f3]">₹15 LPA</strong>
        <span class="text-[#10b981] block mt-0.5">₹1.05L/mo</span>
      </a>
      <a href="/salary/18-lpa" class="p-3.5 rounded-2xl bg-[#fafafa] dark:bg-[#181818] hover:bg-[#f0f0f0] dark:hover:bg-[#202020] transition-colors text-center group">
        <strong class="text-[#171717] dark:text-white block font-medium group-hover:text-[#0070f3]">₹18 LPA</strong>
        <span class="text-[#10b981] block mt-0.5">₹1.24L/mo</span>
      </a>
      <a href="/salary/20-lpa" class="p-3.5 rounded-2xl bg-[#fafafa] dark:bg-[#181818] hover:bg-[#f0f0f0] dark:hover:bg-[#202020] transition-colors text-center group">
        <strong class="text-[#171717] dark:text-white block font-medium group-hover:text-[#0070f3]">₹20 LPA</strong>
        <span class="text-[#10b981] block mt-0.5">₹1.37L/mo</span>
      </a>
      <a href="/salary/25-lpa" class="p-3.5 rounded-2xl bg-[#fafafa] dark:bg-[#181818] hover:bg-[#f0f0f0] dark:hover:bg-[#202020] transition-colors text-center group">

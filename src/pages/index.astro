      <a href="/salary/7-5-lpa" class="p-3.5 rounded-2xl bg-[#fafafa] dark:bg-[#181818] hover:bg-[#f0f0f0] dark:hover:bg-[#202020] transition-colors text-center group">
        <strong class="text-[#171717] dark:text-white block font-medium group-hover:text-[#0070f3]">₹7.5 LPA</strong>
        <span class="text-[#10b981] block mt-0.5">₹57.7k/mo</span>
      </a>
      <a href="/salary/10-lpa" class="p-3.5 rounded-2xl bg-[#fafafa] dark:bg-[#181818] hover:bg-[#f0f0f0] dark:hover:bg-[#202020] transition-colors text-center group">

  <!-- Payroll Documentation Callout Banner -->
  <section class="max-w-5xl mx-auto mt-16 sm:mt-24 p-8 sm:p-12 rounded-3xl bg-white dark:bg-[#121212] shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-6">

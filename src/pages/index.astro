        <span class="text-[#10b981] block mt-0.5">₹3.12L/mo</span>
      </a>
      <a href="/salary/1-cr" class="p-3.5 rounded-2xl bg-[#fafafa] dark:bg-[#181818] hover:bg-[#f0f0f0] dark:hover:bg-[#202020] transition-colors text-center group">

---
import Layout from '../layouts/Layout.astro';
import { OfferComparator } from '../components/OfferComparator';
import FaqSection from '../components/FaqSection.astro';
---

<Layout
  title="Job Offer Letter Comparator India | Compare CTC, ESOPs & Take-Home | inHander.com"
  description="Compare up to 3 job offers side-by-side. Calculate exact monthly take-home salary, variable bonuses, RSU stock grants, joining bonuses, and total 1st year value."
  activeTab="offers"
>
  <div class="space-y-12">
    <OfferComparator client:load />

    <!-- Offer Decision Guide -->
    <section class="max-w-5xl mx-auto p-6 sm:p-8 rounded-2xl bg-white border border-[#ebebeb] shadow-stacked-sm space-y-4">
      <h3 class="text-xl font-bold text-[#171717]">How to evaluate tech job offers in India.</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-[13px] text-[#4d4d4d] leading-relaxed">
        <div>
          <h4 class="font-semibold text-[#171717] mb-1">1. Fixed vs Variable Split</h4>
          <p>Companies often inflate CTC with performance bonuses (10-20%) that are not guaranteed. Focus on the fixed base for your monthly living budget.</p>
        </div>
        <div>
          <h4 class="font-semibold text-[#171717] mb-1">2. ESOPs / RSU Vesting Schedule</h4>
          <p>Standard tech vesting is 4 years with a 1-year cliff (25% per year). Factor in 1st year vested value rather than total 4-year grant size.</p>
        </div>
        <div>
          <h4 class="font-semibold text-[#171717] mb-1">3. Employer EPF & Gratuity</h4>
          <p>Check if employer EPF (12%) and Gratuity (4.81%) are deducted from your stated CTC. Many startups quote CTC inclusive of employer statutory costs.</p>
        </div>
      </div>
    </section>

    <FaqSection />
  </div>
</Layout>
